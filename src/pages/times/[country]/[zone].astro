---
// One zone's prayer times, in the shared place view (today, then the whole
// month, printable). The page is built once per zone; the times load from the
// CDN in the browser, so new months and years need no rebuild.
import Base from "../../../layouts/Base.astro";
import PlaceView from "../../../components/PlaceView.astro";
import { placeText } from "../../../lib/place";
import {
  countryPath,
  getPageCountries,
  zonePath,
  type CountryWithZones,
} from "../../../lib/zonePages";
import type { Zone } from "../../../lib/times";

export async function getStaticPaths() {
  const countries = await getPageCountries();
  return countries.flatMap((c) =>
    c.zones.map((zone) => ({
      params: { country: c.slug, zone: zone.code.toLowerCase() },
      props: { c, zone },
    })),
  );
}

const { c, zone } = Astro.props as { c: CountryWithZones; zone: Zone };
const source = c.country.source;
const text = placeText(zone, c.name, source);

// The tab title keeps every area (for searches).
const title = `Prayer times in ${zone.location}`;
const description = `Today's prayer times and the monthly timetable for ${zone.location}, ${c.name} (${zone.code}), from ${source}. Ready to print.`;

// Small countries list every other zone; bigger ones only the zones in the
// same state (none for e.g. Kuala Lumpur), plus a link to them all.
const others = c.zones.filter((z) => z.code !== zone.code);
const small = c.zones.length <= 14;
const nearby = small ? others : others.filter((z) => z.state === zone.state);
const nearbyHeading = `Other zones in ${small ? c.name : zone.state}`;
---

<Base title={title} description={description}>
  <div
    id="zone-page"
    data-country={c.code}
    data-zone={zone.code}
    data-timezone={zone.timezone}
  >
    <nav class="crumbs muted no-print" aria-label="Breadcrumb">
      <a href="/times/">Prayer times</a>
      {" › "}
      <a href={countryPath(c.code)}>{c.name}</a>
      {" › "}
      {text.short}
    </nav>

    <PlaceView
      level={1}
      heading={text.heading}
      areas={text.areas}
      meta={text.meta}
      printUrl={`simplesolat.com${zonePath(c.code, zone.code)}`}
      printPlace={text.printPlace}
      printMeta={`${zone.code} · Source: ${source}`}
      loading="Loading prayer times…"
    >
      <section slot="others" class="nearby no-print">
        {nearby.length > 0 && <h2 class="others-heading">{nearbyHeading}</h2>}
        {nearby.length > 0 && (
          <ul>
            {nearby.map((z) => (
              <li>
                <a href={zonePath(c.code, z.code)}>{z.location}</a>
              </li>
            ))}
          </ul>
        )}
        {others.length > nearby.length && (
          <p>
            <a href={countryPath(c.code)}>
              All {c.zones.length} zones in {c.name} →
            </a>
          </p>
        )}
      </section>
    </PlaceView>

    <noscript>
      <p>The times load with JavaScript. Turn it on, or see {source}.</p>
    </noscript>
  </div>
</Base>

<script>
  import { type Day, STORE_KEY, getMonth, nowIn } from "../../../lib/times";
  import {
    monthName,
    renderMonthTable,
    shiftMonth,
    showMonthEmpty,
  } from "../../../lib/month";
  import { renderToday, setTodayStatus } from "../../../lib/today";

  const root = document.getElementById("zone-page") as HTMLElement;
  const { country, zone, timezone } = root.dataset as Record<string, string>;
  const el = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T;

  // Remembered for the home page's live times, like choosing it there.
  try {
    localStorage.setItem(STORE_KEY, JSON.stringify([country, zone]));
  } catch {}

  let month = nowIn(timezone).date.slice(0, 7);
  let todayDay: Day | null = null;

  const asked = new URLSearchParams(location.search).get("month");
  if (asked && /^\d{4}-\d{2}$/.test(asked)) month = asked;

  async function loadToday() {
    const today = nowIn(timezone).date;
    const days = await getMonth(country, zone, today.slice(0, 7));
    todayDay = days.find((d) => d.date === today) ?? null;
    if (!todayDay) {
      setTodayStatus("Today's timetable isn't published yet.");
      return;
    }
    renderToday(todayDay, timezone);
  }

  async function loadMonth() {
    el("month-name").textContent = monthName(month);
    try {
      const days = await getMonth(country, zone, month);
      showMonthEmpty(false);
      renderMonthTable(el("head"), el("rows"), days, nowIn(timezone).date);
    } catch {
      showMonthEmpty(true);
    }
    const url = new URL(location.href);
    if (month === nowIn(timezone).date.slice(0, 7))
      url.searchParams.delete("month");
    else url.searchParams.set("month", month);
    history.replaceState(null, "", url);
  }

  el("prev").addEventListener("click", () => {
    month = shiftMonth(month, -1);
    loadMonth();
  });
  el("next").addEventListener("click", () => {
    month = shiftMonth(month, 1);
    loadMonth();
  });
  el("print").addEventListener("click", () => window.print());
  el("copy").addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(location.href);
      el("copied").textContent = "Copied.";
    } catch {
      el("copied").textContent = "Copy the address from the address bar.";
    }
    setTimeout(() => (el("copied").textContent = ""), 3000);
  });

  loadToday().catch(() =>
    setTodayStatus("Couldn't load the prayer times. Please try again."),
  );
  loadMonth();

  // Keep the highlight current while the page is open; reload at midnight.
  setInterval(() => {
    if (todayDay && nowIn(timezone).date !== todayDay.date)
      loadToday().catch(() => {});
    else if (todayDay) renderToday(todayDay, timezone);
  }, 30 * 1000);
</script>

<style>
  .crumbs {
    font-size: 0.85rem;
    margin: 1rem 0 0.5rem;
  }
  .others-heading {
    font-size: 1.35rem;
  }
  .nearby ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.25rem 1.5rem;
    padding-left: 1.2rem;
  }
</style>
