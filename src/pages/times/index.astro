---
// A whole month of prayer times for a zone (or, outside the countries with an
// official timetable, calculated for a location). Runs in the browser like
// the live times on the home page. The address keeps the place and month
// (?country=MY&zone=SGR01&month=2026-10, or ?lat=..&lng=..), so it can be
// bookmarked or shared, and it prints as a one-page timetable. The chosen
// place shows in the same place view as the zone pages; countries with a page
// per zone are listed below.
import Base from "../../layouts/Base.astro";
import PlaceView from "../../components/PlaceView.astro";
import { countryPath, getPageCountries } from "../../lib/zonePages";

const pageCountries = await getPageCountries();
---

<Base
  title="Prayer times"
  description="A whole month of prayer times for your zone, from the official timetables (JAKIM and others). Print it or share the link."
>
  <section class="month-page" aria-labelledby="month-heading">
    <h1 id="month-heading" class="no-print">
      Prayer times
    </h1>
    <p class="lead muted no-print">
      Today's times and the whole month for any zone, ready to print.
    </p>

    <div class="controls no-print">
      <button type="button" class="button" id="locate">
        Use my location
      </button>
      <span class="muted or">or</span>
      <label>
        <span class="sr-only">Country</span>
        <select id="country" disabled>
          <option value="">Loading countries…</option>
        </select>
      </label>
      <label>
        <span class="sr-only">Zone</span>
        <select id="zone" disabled>
          <option value="">Choose a zone</option>
        </select>
      </label>
    </div>

    <p id="status" class="status muted no-print" aria-live="polite"></p>

    <noscript>
      <p>Prayer times load with JavaScript. Turn it on to use this page.</p>
    </noscript>

    <div id="result" hidden>
      <PlaceView level={2} printUrl="simplesolat.com/times">
        <p slot="links" id="permalink" class="permalink" hidden>
          <a id="permalink-link" href="/times/">
            This zone's own page, to share or bookmark →
          </a>
        </p>
        <section slot="others" id="others" class="nearby no-print" hidden>
          <h3 id="others-heading" class="others-heading"></h3>
          <ul id="others-list"></ul>
          <p id="others-all" hidden>
            <a id="others-all-link" href="/times/"></a>
          </p>
        </section>
      </PlaceView>
    </div>

    <p class="privacy muted no-print">
      Your location stays in your browser. It's matched against zone boundaries
      right here, and only your zone's timetable is downloaded.
    </p>
  </section>

  <section class="browse no-print" aria-labelledby="browse-heading">
    <h2 id="browse-heading">Browse by country</h2>
    <ul class="countries">
      {pageCountries.map((c) => (
        <li>
          <a href={countryPath(c.code)}>{c.country.name}</a>
          <span class="muted">
            {" "}
            · {c.zones.length} {c.zones.length === 1 ? "zone" : "zones"} ·{" "}
            {c.country.source}
          </span>
        </li>
      ))}
    </ul>
  </section>
</Base>

<script>
  import { calculateDay, loadMethods } from "../../lib/calculate";
  import {
    monthName,
    renderMonthTable,
    shiftMonth,
    showMonthEmpty,
  } from "../../lib/month";
  import { placeText } from "../../lib/place";
  import { renderToday, setTodayStatus } from "../../lib/today";
  import { countryPath, hasZonePages, zonePath } from "../../lib/zonePages";
  import {
    type Country,
    type Day,
    STORE_KEY,
    fillZones,
    findWorldCountry,
    findZone,
    getCountries,
    getMonth,
    getPosition,
    getZones,
    nowIn,
    type Zone,
  } from "../../lib/times";

  const el = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T;
  const countrySel = el<HTMLSelectElement>("country");
  const zoneSel = el<HTMLSelectElement>("zone");
  const status = el<HTMLParagraphElement>("status");
  const result = el<HTMLDivElement>("result");

  let countries: Country[] = [];

  // The place on screen: an official zone, or a location to calculate for.
  type Place =
    | { kind: "zone"; country: string; zone: string }
    | { kind: "point"; lat: number; lng: number };
  let place: Place | null = null;
  let month = ""; // "YYYY-MM"
  // The current month where the place is: left out of shared links, so a
  // link always opens on that day's month.
  let currentMonth = "";

  const setStatus = (text: string) => (status.textContent = text);

  // The address for what's on screen, so it can be bookmarked or shared.
  function updateUrl() {
    if (!place) return;
    const params = new URLSearchParams();
    if (place.kind === "zone") {
      params.set("country", place.country);
      params.set("zone", place.zone);
    } else {
      params.set("lat", place.lat.toFixed(2));
      params.set("lng", place.lng.toFixed(2));
    }
    if (month !== currentMonth) params.set("month", month);
    history.replaceState(null, "", `?${params}`);
  }

  const renderTable = (days: Day[], today: string) =>
    renderMonthTable(el("head"), el("rows"), days, today);

  // The place heading, meta line, link to the zone's own page and other zones
  // (same as on a zone page).
  function showZoneHeader(country: Country, zone: Zone, zones: Zone[]) {
    const text = placeText(zone, country.name, country.source);
    el("place-heading").textContent = text.heading;
    el("place-areas").textContent = text.areas;
    el("place-areas").hidden = !text.areas;
    el("place-meta").textContent = text.meta;
    el("place").textContent = text.printPlace;
    el("meta").textContent = `${zone.code} · Source: ${country.source}`;

    const hasPage = hasZonePages(country.code);
    const linkTo = (z: Zone) =>
      hasPage
        ? zonePath(country.code, z.code)
        : `/times/?country=${country.code}&zone=${z.code}`;
    el("permalink").hidden = !hasPage;
    el<HTMLAnchorElement>("permalink-link").href = linkTo(zone);
    // Printed with the zone's own page where there is one.
    el("print-url").textContent = hasPage
      ? `simplesolat.com${zonePath(country.code, zone.code)}`
      : "simplesolat.com/times";

    const others = zones.filter((z) => z.code !== zone.code);
    const small = zones.length <= 14;
    const nearby = small
      ? others
      : others.filter((z) => z.state === zone.state);
    el("others-heading").textContent =
      `Other zones in ${small ? country.name : zone.state}`;
    el("others-heading").hidden = nearby.length === 0;
    el("others-list").replaceChildren(
      ...nearby.map((z) => {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = linkTo(z);
        a.textContent = z.location;
        li.append(a);
        return li;
      }),
    );
    const showAll = hasPage && others.length > nearby.length;
    el("others-all").hidden = !showAll;
    const all = el<HTMLAnchorElement>("others-all-link");
    all.href = countryPath(country.code);
    all.textContent = `All ${zones.length} zones in ${country.name} →`;
    el("others").hidden = nearby.length === 0 && !showAll;
  }

  async function render() {
    if (!place) return;
    const [y, m] = month.split("-").map(Number);
    el("month-name").textContent = monthName(month);

    if (place.kind === "zone") {
      const { country: cc, zone: zc } = place;
      const country = countries.find((c) => c.code === cc);
      const zones = await getZones(cc);
      const zone = zones.find((z) => z.code === zc);
      if (!country || !zone) {
        setStatus("That zone wasn't found. Choose one below.");
        return;
      }
      showZoneHeader(country, zone, zones);
      setStatus(`Loading prayer times for ${zone.location}…`);
      const today = nowIn(zone.timezone).date;
      currentMonth = today.slice(0, 7);
      result.hidden = false;

      // Today, from this month (whatever month the table shows).
      getMonth(cc, zc, currentMonth)
        .then((days) => {
          const day = days.find((d) => d.date === today);
          if (day) renderToday(day, zone.timezone);
          else setTodayStatus("Today's timetable isn't published yet.");
        })
        .catch(() =>
          setTodayStatus("Couldn't load the prayer times. Please try again."),
        );

      try {
        const days = await getMonth(cc, zc, month);
        showMonthEmpty(false);
        renderTable(days, today);
      } catch {
        // Keep the place and the month buttons, so another month is a tap
        // away.
        showMonthEmpty(true);
      }
      document.title = `${zone.location}, ${el("month-name").textContent} · simplesolat`;
    } else {
      const { lat, lng } = place;
      setStatus("Calculating prayer times for your location…");
      const country = await findWorldCountry(lat, lng);
      await loadMethods();
      const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
      currentMonth = nowIn(timezone).date.slice(0, 7);
      showMonthEmpty(false);
      const count = new Date(y, m, 0).getDate();
      let label = "";
      const days: Day[] = [];
      for (let d = 1; d <= count; d++) {
        const r = calculateDay(
          new Date(y, m - 1, d, 12),
          lat,
          lng,
          country?.ISO_A2 ?? null,
          timezone,
        );
        label = r.label;
        days.push({
          date: `${month}-${String(d).padStart(2, "0")}`,
          ...r.times,
        });
      }
      const near = country
        ? `near ${lat.toFixed(2)}, ${lng.toFixed(2)}, ${country.NAME}`
        : `near ${lat.toFixed(2)}, ${lng.toFixed(2)}`;
      el("place-heading").textContent = `Prayer times ${near}`;
      el("place-areas").hidden = true;
      el("place-meta").textContent =
        `Calculated (${label}). No official timetable here.`;
      el("place").textContent = `Near ${near.slice(5)}`;
      el("meta").textContent = el("place-meta").textContent;
      el("print-url").textContent = "simplesolat.com/times";
      el("permalink").hidden = true;
      el("others").hidden = true;

      const today = calculateDay(
        new Date(),
        lat,
        lng,
        country?.ISO_A2 ?? null,
        timezone,
      );
      renderToday({ date: nowIn(timezone).date, ...today.times }, timezone);
      renderTable(days, nowIn(timezone).date);
      result.hidden = false;
    }
    setStatus("");
    updateUrl();
  }

  async function showZone(countryCode: string, zoneCode: string) {
    place = { kind: "zone", country: countryCode, zone: zoneCode };
    const zone = (await getZones(countryCode)).find((z) => z.code === zoneCode);
    if (!month && zone) month = nowIn(zone.timezone).date.slice(0, 7);
    await render();
    try {
      localStorage.setItem(STORE_KEY, JSON.stringify([countryCode, zoneCode]));
    } catch {}
  }

  async function locate() {
    setStatus("Finding your location…");
    const pos = await getPosition();
    if (!pos) {
      setStatus("Couldn't get your location. Choose a zone instead.");
      return;
    }
    const { latitude: lat, longitude: lng } = pos.coords;
    const found = await findZone(countries, lat, lng, setStatus);
    if (found) {
      countrySel.value = found.country.code;
      await fillZones(zoneSel, found.country.code, found.zone);
      await showZone(found.country.code, found.zone);
      return;
    }
    countrySel.value = "";
    zoneSel.replaceChildren(new Option("Choose a zone", ""));
    zoneSel.disabled = true;
    place = { kind: "point", lat, lng };
    await render();
  }

  async function init() {
    try {
      countries = await getCountries();
    } catch {
      setStatus("Couldn't load the list of countries. Please try again later.");
      return;
    }
    countrySel.replaceChildren(
      new Option("Choose a country", ""),
      ...countries.map((c) => new Option(c.name, c.code)),
    );
    countrySel.disabled = false;

    countrySel.addEventListener("change", async () => {
      result.hidden = true;
      place = null;
      if (countrySel.value) await fillZones(zoneSel, countrySel.value);
    });
    zoneSel.addEventListener("change", () => {
      if (zoneSel.value)
        showZone(countrySel.value, zoneSel.value).catch(() =>
          setStatus("Couldn't load the prayer times. Please try again."),
        );
    });
    el("locate").addEventListener("click", () =>
      locate().catch(() =>
        setStatus("Something went wrong. Choose a zone instead."),
      ),
    );
    el("prev").addEventListener("click", () => {
      month = shiftMonth(month, -1);
      render().catch(() => setStatus("Couldn't load the prayer times."));
    });
    el("next").addEventListener("click", () => {
      month = shiftMonth(month, 1);
      render().catch(() => setStatus("Couldn't load the prayer times."));
    });
    el("print").addEventListener("click", () => window.print());
    el("copy").addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        el("copied").textContent = "Copied.";
      } catch {
        el("copied").textContent = "Copy the address from the address bar.";
      }
      setTimeout(() => (el("copied").textContent = ""), 3000);
    });

    // A shared or bookmarked link first, then the zone chosen last time.
    const params = new URLSearchParams(location.search);
    const m = params.get("month");
    if (m && /^\d{4}-\d{2}$/.test(m)) month = m;
    const lat = Number(params.get("lat"));
    const lng = Number(params.get("lng"));
    const cc = params.get("country");
    const zc = params.get("zone");

    if (cc && zc && countries.some((c) => c.code === cc)) {
      countrySel.value = cc;
      await fillZones(zoneSel, cc, zc);
      await showZone(cc, zc);
      return;
    }
    if (
      params.has("lat") &&
      params.has("lng") &&
      isFinite(lat) &&
      isFinite(lng)
    ) {
      if (!month)
        month = nowIn(
          Intl.DateTimeFormat().resolvedOptions().timeZone,
        ).date.slice(0, 7);
      place = { kind: "point", lat, lng };
      await render();
      return;
    }
    let saved: [string, string] | null = null;
    try {
      saved = JSON.parse(localStorage.getItem(STORE_KEY) ?? "null");
    } catch {}
    if (saved && countries.some((c) => c.code === saved[0])) {
      countrySel.value = saved[0];
      await fillZones(zoneSel, saved[0], saved[1]);
      await showZone(saved[0], saved[1]).catch(() => {});
    }
  }

  init();
</script>

<style>
  .month-page h1 {
    margin-bottom: 1rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }
  .or {
    font-size: 0.9rem;
  }
  .controls label {
    flex: 1 1 12rem;
    min-width: 0;
  }
  select {
    width: 100%;
    font: inherit;
    font-size: 0.9rem;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    max-width: 100%;
  }
  .status:empty {
    display: none;
  }
  .privacy {
    font-size: 0.85rem;
  }
  .permalink {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
  }
  .others-heading {
    font-size: 1.35rem;
    margin-block: 2rem 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .nearby ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.25rem 1.5rem;
    padding-left: 1.2rem;
  }
  .countries {
    padding-left: 1.2rem;
  }
  .countries li {
    margin-block: 0.3rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
