---
// Live prayer times for a chosen zone, or for the visitor's location.
// Everything happens in the browser: the location is matched against zone
// boundaries locally, and only the zone's timetable is fetched, exactly as
// the app does it. Data comes from the public simplesolat-data CDN.
import TodayCard from "./TodayCard.astro";
---

<section class="live" aria-labelledby="times-heading">
  <h2 id="times-heading" class="live-heading">
    Prayer times today
  </h2>

  <div class="controls">
    <button type="button" class="button" id="locate">
      Use my location
    </button>
    <span class="muted or">or</span>
    <label>
      <span class="sr-only">Country</span>
      <select id="country" disabled>
        <option value="">Loading countries…</option>
      </select>
    </label>
    <label>
      <span class="sr-only">Zone</span>
      <select id="zone" disabled>
        <option value="">Choose a zone</option>
      </select>
    </label>
  </div>

  <p id="status" class="status muted" aria-live="polite"></p>

  <div id="result" hidden>
    <p class="place">
      <strong id="place"></strong>
      <br />
      <span id="meta" class="muted"></span>
    </p>
    <TodayCard level={null} plain />
    <p class="month">
      <a id="month-link" href="/times/">
        See the whole month →
      </a>
    </p>
  </div>

  <p class="privacy muted">
    Your location stays in your browser. It's matched against zone boundaries
    right here, and only your zone's timetable is downloaded. Outside the
    countries with an official timetable, the times are calculated right here
    too.
  </p>
</section>

<script>
  import { calculateDay } from "../lib/calculate";
  import {
    type Country,
    type Day,
    STORE_KEY,
    fillZones,
    findWorldCountry,
    findZone,
    getCountries,
    getMonth,
    getPosition,
    getZones,
    nowIn,
  } from "../lib/times";
  import { placeText } from "../lib/place";
  import { renderToday } from "../lib/today";
  import { hasZonePages, zonePath } from "../lib/zonePages";

  const el = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T;
  const countrySel = el<HTMLSelectElement>("country");
  const zoneSel = el<HTMLSelectElement>("zone");
  const locateBtn = el<HTMLButtonElement>("locate");
  const status = el<HTMLParagraphElement>("status");
  const result = el<HTMLDivElement>("result");
  const monthLink = el<HTMLAnchorElement>("month-link");

  let countries: Country[] = [];
  // What's on screen: an official zone, or times calculated for a location.
  type View = {
    place: string;
    meta: string;
    timezone: string;
    day: Day;
    // The month page for the same place.
    monthHref: string;
    reload: () => Promise<void>;
  };
  let current: View | null = null;

  const setStatus = (text: string) => (status.textContent = text);

  function render() {
    if (!current) return;
    const { place, meta, timezone, day } = current;
    el("place").textContent = place;
    el("meta").textContent = meta;
    // The same Today card as on /times/ and the zone pages.
    renderToday(day, timezone);
    monthLink.href = current.monthHref;
    result.hidden = false;
  }

  async function show(countryCode: string, zoneCode: string) {
    const country = countries.find((c) => c.code === countryCode);
    const zone = (await getZones(countryCode)).find((z) => z.code === zoneCode);
    if (!country || !zone) return;

    setStatus(`Loading prayer times for ${zone.location}…`);
    const today = nowIn(zone.timezone).date;
    const days = await getMonth(country.code, zone.code, today.slice(0, 7));
    const day = days.find((d) => d.date === today);
    if (!day) {
      setStatus("Today's timetable isn't available for this zone yet.");
      return;
    }

    current = {
      // Same wording as /times/ and the zone pages.
      place: zone.location,
      meta: placeText(zone, country.name, country.source).meta,
      timezone: zone.timezone,
      day,
      monthHref: hasZonePages(country.code)
        ? zonePath(country.code, zone.code)
        : `/times/?country=${country.code}&zone=${zone.code}`,
      reload: () => show(countryCode, zoneCode),
    };
    render();
    setStatus("");
    try {
      localStorage.setItem(STORE_KEY, JSON.stringify([countryCode, zoneCode]));
    } catch {}
  }

  async function locate() {
    setStatus("Finding your location…");
    const pos = await getPosition();
    if (!pos) {
      setStatus("Couldn't get your location. Choose a zone instead.");
      return;
    }
    const { latitude: lat, longitude: lng } = pos.coords;
    const found = await findZone(countries, lat, lng, setStatus);
    if (found) {
      countrySel.value = found.country.code;
      await fillZones(zoneSel, found.country.code, found.zone);
      await show(found.country.code, found.zone);
      return;
    }
    await showCalculated(lat, lng);
  }

  // Outside the countries with an official timetable, calculate the times
  // here in the browser, with the method the app uses for that country.
  async function showCalculated(lat: number, lng: number) {
    setStatus("Calculating prayer times for your location…");
    // Without the country, the default method is used.
    const country = await findWorldCountry(lat, lng);
    const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
    const { label, times } = calculateDay(
      new Date(),
      lat,
      lng,
      country?.ISO_A2 ?? null,
      timezone,
    );

    countrySel.value = "";
    zoneSel.replaceChildren(new Option("Choose a zone", ""));
    zoneSel.disabled = true;
    current = {
      place: country ? `Near you, ${country.NAME}` : "Near you",
      meta: `Calculated (${label}). No official timetable here.`,
      timezone,
      day: { date: nowIn(timezone).date, ...times },
      // Rounded to about a kilometre: close enough for prayer times, and
      // the link doesn't give away an exact location if it's shared.
      monthHref: `/times/?lat=${lat.toFixed(2)}&lng=${lng.toFixed(2)}`,
      reload: () => showCalculated(lat, lng),
    };
    render();
    setStatus("");
  }

  async function init() {
    try {
      countries = await getCountries();
    } catch {
      setStatus("Couldn't load the list of countries. Please try again later.");
      return;
    }

    countrySel.replaceChildren(
      new Option("Choose a country", ""),
      ...countries.map((c) => new Option(c.name, c.code)),
    );
    countrySel.disabled = false;

    countrySel.addEventListener("change", async () => {
      result.hidden = true;
      current = null;
      if (countrySel.value) await fillZones(zoneSel, countrySel.value);
    });
    zoneSel.addEventListener("change", () => {
      if (zoneSel.value)
        show(countrySel.value, zoneSel.value).catch(() =>
          setStatus("Couldn't load the prayer times. Please try again."),
        );
    });
    locateBtn.addEventListener("click", () =>
      locate().catch(() =>
        setStatus("Something went wrong. Choose a zone instead."),
      ),
    );

    // Keep the highlight current while the page is open.
    setInterval(() => {
      if (!current) return;
      if (nowIn(current.timezone).date !== current.day.date) {
        current.reload().catch(() => {});
      } else {
        render();
      }
    }, 30 * 1000);

    let saved: [string, string] | null = null;
    try {
      saved = JSON.parse(localStorage.getItem(STORE_KEY) ?? "null");
    } catch {}
    if (saved && countries.some((c) => c.code === saved[0])) {
      countrySel.value = saved[0];
      await fillZones(zoneSel, saved[0], saved[1]);
      await show(saved[0], saved[1]).catch(() => {});
    }
  }

  init();
</script>

<style>
  .live {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1rem 1.25rem 1.25rem;
    margin-block: 2rem;
  }
  .live-heading {
    margin: 0 0 1rem;
    padding: 0;
    border: 0;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }
  .or {
    font-size: 0.9rem;
  }
  .controls label {
    flex: 1 1 12rem;
    min-width: 0;
  }
  select {
    width: 100%;
    font: inherit;
    font-size: 0.9rem;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    max-width: 100%;
  }
  .status:empty {
    display: none;
  }
  .place {
    margin: 1.25rem 0 0.25rem;
    font-size: 1.1rem;
  }
  .place .muted {
    font-size: 0.85rem;
  }
  .month {
    margin: 0.75rem 0 0;
  }
  .note,
  .privacy {
    font-size: 0.85rem;
    margin-bottom: 0;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
